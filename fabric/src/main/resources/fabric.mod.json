{
  "schemaVersion": 1,
  "id": "ivespoken",
  "version": "${version}",
  "name": "${displayName}",
  "description": "Displays RPG-like dialogs above players' names. I've spoken.",
  "authors": [
    "Kessoku Tea Time",
    "KrLite"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/ive-spoken",
    "sources": "https://github.com/KessokuTeaTime/Ive-Spoken",
    "issues": "https://github.com/KessokuTeaTime/Ive-Spoken/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/ivespoken/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "band.kessokuteatime.ivespoken.fabric.IveSpokenFabric"
    ],
    "modmenu": [
      "band.kessokuteatime.ivespoken.fabric.IveSpokenModMenuIntegration"
    ]
  },
  "mixins": [
    "ivespoken.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabricLoaderVersion}",
    "minecraft": "${fabricMinecraftVersionRange}",
    "java": ">=${javaVersion}",
    "cloth-config": ">=${clothConfigVersion}"
  }
}
